# ---- Database (Postgres, via docker-compose) ----
POSTGRES_PASSWORD=collab_password
DATABASE_URL="postgresql://collab_user:collab_password@localhost:5432/collab_db?schema=public"

# ---- Redis (via docker-compose) ----
REDIS_URL="redis://localhost:6379"

# ---- NextAuth v5 ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App -> https://github.com/settings/developers
# Callback URL must be: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# ---- Standalone Socket.io + Yjs server ----
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"